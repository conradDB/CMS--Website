{% assign chosen_collection = section.settings.collection | default: collections.all %}
<section class="lt-featured lt-section" id="lt-curated" aria-labelledby="lt-featured-heading-{{ section.id }}"><div class="lt-section-head"><div><p class="lt-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="lt-featured-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div><a class="lt-text-link" href="{{ chosen_collection.url | default: routes.all_products_collection_url }}">VIEW ALL TIMEPIECES <span aria-hidden="true">⟶</span></a></div><div class="lt-product-grid">{% for product in chosen_collection.products limit: section.settings.products_to_show %}{% render 'lt-product-card', product: product %}{% else %}<div class="lt-empty-collection"><p>Your next chapter awaits.</p><a class="lt-button" href="{{ routes.all_products_collection_url }}">EXPLORE THE COLLECTION <span aria-hidden="true">⟶</span></a></div>{% endfor %}</div></section>
{% schema %}
{
  "name": "Luxurytime \u00b7 Timepieces",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label",
      "default": "THE SELECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Exceptional, by nature."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection",
      "info": "If empty, products from All products are shown."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Luxurytime \u00b7 Timepieces"
    }
  ]
}
{% endschema %}
