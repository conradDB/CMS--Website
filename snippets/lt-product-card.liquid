<article class="lt-product"><a class="lt-product-image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{% if product.featured_image != blank %}<img src="{{ product.featured_image | image_url: width: 800 }}" srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 800 }} 800w" sizes="(max-width: 749px) 46vw, 25vw" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" loading="lazy">{% else %}{{ 'product-1' | placeholder_svg_tag: 'lt-placeholder' }}{% endif %}<span class="lt-product-explore" aria-hidden="true">EXPLORE <span>↗</span></span>{% unless product.available %}<span class="lt-sold-out">{{ 'products.product.sold_out' | t }}</span>{% endunless %}</a><div class="lt-product-info"><p class="lt-product-vendor">{{ product.vendor | escape }}</p><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><p class="lt-product-price">{% if product.lt_preview %}ILLUSTRATIVE CATALOGUE PREVIEW{% else %}{% if product.price_varies %}{{ 'products.product.price.from_price_html' | t: price: '' }} {% endif %}{{ product.price | money_with_currency }}{% endif %}</p></div></article>
