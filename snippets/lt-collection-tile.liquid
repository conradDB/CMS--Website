{% assign tile_image = collection.featured_image | default: collection.products.first.featured_image %}<a class="lt-collection-tile" href="{{ collection.url }}" {{ attributes }}>{% if tile_image != blank %}<img src="{{ tile_image | image_url: width: 600 }}" alt="{{ tile_image.alt | default: collection.title | escape }}" width="{{ tile_image.width }}" height="{{ tile_image.height }}" loading="lazy">{% endif %}<span>{{ title | default: collection.title | escape }}<small>EXPLORE THE COLLECTION</small></span><b aria-hidden="true">↗</b></a>
